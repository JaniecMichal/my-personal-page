# Public site URL (no trailing slash), used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://mjaniec.it

# Content source: "local" (TypeScript data in src/content/local) or "sanity" (not wired yet).
CONTENT_SOURCE=local

# Mailgun, for the brief/contact form.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.mjaniec.it
# "eu" for EU-hosted domains (api.eu.mailgun.net), "us" otherwise.
MAILGUN_REGION=eu
MAILGUN_FROM="mjaniec.it <no-reply@mg.mjaniec.it>"
CONTACT_TO_EMAIL=michal.janiec95@gmail.com

# Terminal easter egg (optional).
OPENAI_API_KEY=

# Sanity (for later).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Search engine verification (optional; a DNS TXT record on the domain property is preferred).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Local only: pretend the visitor is in this country (Vercel sets x-vercel-ip-country in production).
DEV_GEO_COUNTRY=
